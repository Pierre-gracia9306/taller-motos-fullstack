      "name": "01. Autenticación",
      "item": [
        {
          "name": "POST Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// 1. Validar que la respuesta sea HTTP 200\r\npm.test(\"Status code es 200 OK\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\n// 2. Extraer el accessToken y guardarlo automáticamente en la variable de entorno\r\nvar responseData = pm.response.json();\r\nif (responseData.data && responseData.data.accessToken) {\r\n    pm.environment.set(\"accessToken\", responseData.data.accessToken);\r\n    console.log(\"Token capturado exitosamente!\");\r\n}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"email\": \"admin@taller.com\",\r\n  \"password\": \"Admin123*\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          },
          "response": []
        },
